# Cloudflare Pages headers: the same as the [[headers]] in netlify.toml (see the notes there).
# Copied into dist/ only by `npm run build:pages`, so Netlify builds stay exactly as they were.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Logos, the hero photo and the map style keep their names when they change: browsers keep them a
# day (and check in the background after that) instead of asking on every visit.
/logo.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logo-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/ghani-press.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/map/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/admin/*
  X-Robots-Tag: noindex, nofollow

/trader/*
  X-Robots-Tag: noindex, nofollow

/delivery/*
  X-Robots-Tag: noindex, nofollow

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
