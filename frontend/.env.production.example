# Set these in Cloudflare Pages → each project → Settings → Variables and secrets
# (sanathanatattava, sanathanatattva-partner, sanathanatattva-delivery).
#
# The API through Cloudflare (it caches the product list and photos):
VITE_API_URL=https://api.sanathanatattva.shop

# Optional fallbacks (comma-separated). App auto-fails over in this order:
#   VITE_API_URL -> VITE_API_URL_CANDIDATES -> VITE_API_URL_FALLBACK
# The same server reached directly, for when the Cloudflare route can't get through:
VITE_API_URL_FALLBACK=https://sanathanatattava-production-67b1.up.railway.app
# VITE_API_URL_CANDIDATES=https://backup-1.example.com,https://backup-2.example.com

# ── Firebase (consumer Google sign-in) ────────────────────────────────
# Get these from Firebase console → Project settings → Your apps → Web app.
# The apiKey is safe to expose (it's an identifier, not a secret).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
